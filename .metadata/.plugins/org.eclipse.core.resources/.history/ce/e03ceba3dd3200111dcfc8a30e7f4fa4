#include "sh2_hal.h"
#include "stm32G0xx_hal.h" // IMPORTANT: Change 'f4' to match your STM32 family (e.g., stm32g4xx_hal.h)

// Pull in the I2C handle generated by CubeMX in main.c
extern I2C_HandleTypeDef hi2c3;

// BNO085 I2C Address (0x4A or 0x4B depending on SA0 pin).
// STM32 HAL requires the address to be shifted left by 1 bit.
#define BNO085_I2C_ADDR (0x4A << 1)

// Forward declarations for the SH2 HAL struct
static int stm32_hal_open(sh2_hal_t *self);
static void stm32_hal_close(sh2_hal_t *self);
static int stm32_hal_read(sh2_hal_t *self, uint8_t *pBuffer, unsigned len, uint32_t *t_us);
static int stm32_hal_write(sh2_hal_t *self, uint8_t *pBuffer, unsigned len);
static uint32_t stm32_hal_getTimeUs(sh2_hal_t *self);

// This is the struct you will pass to the sh2_open() function in main.c
sh2_hal_t sh2Hal = {
    .open = stm32_hal_open,
    .close = stm32_hal_close,
    .read = stm32_hal_read,
    .write = stm32_hal_write,
    .getTimeUs = stm32_hal_getTimeUs
};

static int stm32_hal_open(sh2_hal_t *self) {
    // CubeMX already initializes I2C, so we just return success (0).
    // If you need to toggle the BNO085 reset pin, do it here.
    return 0;
}

static void stm32_hal_close(sh2_hal_t *self) {
    // Not strictly needed for basic I2C operation
}

static int stm32_hal_read(sh2_hal_t *self, uint8_t *pBuffer, unsigned len, uint32_t *t_us) {
    uint8_t header[4];
    uint16_t packet_len = 0;

    // 1. Read the 4-byte SHTP header to find out how much data is waiting
    if (HAL_I2C_Master_Receive(&hi2c1, BNO085_I2C_ADDR, header, 4, 50) != HAL_OK) {
        return 0; // I2C Read failed or no device
    }

    // 2. Calculate length (Bytes 0 and 1, mask out the MSB continuation bit)
    packet_len = (header[1] << 8 | header[0]) & 0x7FFF;

    // 3. Validate the length
    if (packet_len == 0 || packet_len > len) {
        return 0; // Empty packet or packet too large for the provided buffer
    }

    // 4. Read the full packet (SHTP protocol requires reading the header AGAIN with the payload)
    if (HAL_I2C_Master_Receive(&hi2c1, BNO085_I2C_ADDR, pBuffer, packet_len, 100) != HAL_OK) {
        return 0;
    }

    // 5. Record the timestamp if requested
    if (t_us != NULL) {
        *t_us = stm32_hal_getTimeUs(self);
    }

    return packet_len; // Return the number of bytes read
}

static int stm32_hal_write(sh2_hal_t *self, uint8_t *pBuffer, unsigned len) {
    // Transmit the data over I2C
    if (HAL_I2C_Master_Transmit(&hi2c1, BNO085_I2C_ADDR, pBuffer, len, 100) == HAL_OK) {
        return len; // Return number of bytes written
    }
    return 0; // Write failed
}

static uint32_t stm32_hal_getTimeUs(sh2_hal_t *self) {
    // The library expects microseconds.
    // HAL_GetTick() provides milliseconds, so we multiply by 1000.
    return HAL_GetTick() * 1000;
}

