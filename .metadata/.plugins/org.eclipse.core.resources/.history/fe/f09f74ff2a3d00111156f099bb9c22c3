static int16_t le16(const uint8_t *p)
{
    return (int16_t)(((uint16_t)p[1] << 8) | p[0]);
}

static HAL_StatusTypeDef bno_write_packet(uint8_t channel, const uint8_t *data,
                                          uint16_t data_len)
{
    uint8_t pkt[32];
    uint16_t total_len = data_len + 4;
    if (total_len > sizeof(pkt)) return HAL_ERROR;

    pkt[0] = (uint8_t)(total_len & 0xFF);
    pkt[1] = (uint8_t)((total_len >> 8) & 0x7F);
    pkt[2] = channel;
    pkt[3] = imu_seq_nums[channel]++;

    memcpy(&pkt[4], data, data_len);
    return HAL_I2C_Master_Transmit(&hi2c3, BNO_ADDR, pkt, total_len, 100);
}

static void bno_send_set_feature(uint8_t report_id, uint32_t interval_us)
{
    uint8_t cmd[17] = {0};
    cmd[0]  = REPORTID_SET_FEATURE_CMD;
    cmd[1]  = report_id;
    cmd[5]  = (uint8_t)(interval_us & 0xFF);
    cmd[6]  = (uint8_t)((interval_us >> 8) & 0xFF);
    cmd[7]  = (uint8_t)((interval_us >> 16) & 0xFF);
    cmd[8]  = (uint8_t)((interval_us >> 24) & 0xFF);

    bno_write_packet(BNO_CH_CONTROL, cmd, sizeof(cmd));
}

static void IMU_Init(void)
{
    HAL_Delay(400);

    uint8_t retries = 15;
    while (retries > 0) {
        if (HAL_I2C_IsDeviceReady(&hi2c3, BNO_ADDR, 3, 100) == HAL_OK) break;
        HAL_Delay(150);
        retries--;
    }
    if (retries == 0) return;  /* IMU absent; continue without */

    HAL_Delay(100);

    /* Drain any startup advertisements */
    for (int i = 0; i < 20; i++) {
        uint8_t tmp[4];
        HAL_I2C_Master_Receive(&hi2c3, BNO_ADDR, tmp, 4, 10);
        HAL_Delay(5);
    }
    HAL_Delay(50);

    bno_send_set_feature(REPORTID_ACCELEROMETER, 10000);
    HAL_Delay(50);
    bno_send_set_feature(REPORTID_GYROSCOPE, 10000);
    HAL_Delay(50);
}

static IMU_Data_t Read_IMU(void)
{
    /* Non-blocking-ish: short timeout; on failure we return cached data. */
    if (HAL_I2C_Master_Receive(&hi2c3, BNO_ADDR, imu_pkt_buf, 64,
                               IMU_READ_TIMEOUT_MS) != HAL_OK) {
        imu_error_count++;
        return current_imu_data;
    }

    uint16_t pkt_len = ((uint16_t)(imu_pkt_buf[1] & 0x7F) << 8) | imu_pkt_buf[0];
    if (pkt_len <= 4 || pkt_len > 64) return current_imu_data;

    uint8_t channel = imu_pkt_buf[2];
    uint16_t cargo_len = pkt_len - 4;
    uint8_t *cargo = &imu_pkt_buf[4];

    if (channel != BNO_CH_INPUT_REPORTS || cargo_len < 5) return current_imu_data;

    uint16_t offset = 0;
    if (cargo[offset] == 0xFB && cargo_len >= 5) offset += 5;  /* timebase ref */

    while ((offset + 10) <= cargo_len) {
        uint8_t rid = cargo[offset];
        int16_t x = le16(&cargo[offset + 4]);
        int16_t y = le16(&cargo[offset + 6]);
        int16_t z = le16(&cargo[offset + 8]);

        if (rid == REPORTID_ACCELEROMETER) {
            current_imu_data.ax = x / 256.0f;
            current_imu_data.ay = y / 256.0f;
            current_imu_data.az = z / 256.0f;
            offset += 10;
        } else if (rid == REPORTID_GYROSCOPE) {
            current_imu_data.gx = x / 512.0f;
            current_imu_data.gy = y / 512.0f;
            current_imu_data.gz = z / 512.0f;
            offset += 10;
        } else {
            break;  /* unexpected report: don't risk mis-alignment */
        }
    }
    return current_imu_data;
}

/* ==========================================================================
 * Frame transmit helpers
 *
 * Each Send_* builds a complete framed packet into a stack buffer and pushes
 * it into the TX ring. Pushes are atomic w.r.t. each other and the TX IRQ.
 * ========================================================================== */

static void tx_build_and_push(uint8_t type, const uint8_t *payload, uint8_t len)
{
    if ((uint16_t)len + FRAME_OVERHEAD > MAX_FRAME_SIZE) return;
    uint8_t buf[MAX_FRAME_SIZE];

    buf[0] = SOF;
    buf[1] = PROTO_VER;
    buf[2] = type;
    buf[3] = len;
    if (len && payload) memcpy(&buf[4], payload, len);

    uint16_t crc = crc16_ccitt(&buf[1], (uint16_t)(3 + len));
    buf[4 + len]     = (uint8_t)(crc & 0xFF);
    buf[4 + len + 1] = (uint8_t)((crc >> 8) & 0xFF);

    UART_TxPush(buf, (uint16_t)(FRAME_OVERHEAD + len));
}

static void Send_Odom(void)
{
    uint8_t p[LEN_ODOM];
    memcpy(&p[0],  &robot_X,     4);
    memcpy(&p[4],  &robot_Y,     4);
    memcpy(&p[8],  &robot_Theta, 4);
    memcpy(&p[12], &odom_v,      4);
    memcpy(&p[16], &odom_w,      4);
    tx_build_and_push(TYPE_ODOM, p, LEN_ODOM);
}

static void Send_Imu(const IMU_Data_t *d)
{
    uint8_t p[LEN_IMU];
    memcpy(&p[0],  &d->gx, 4);
    memcpy(&p[4],  &d->gy, 4);
    memcpy(&p[8],  &d->gz, 4);
    memcpy(&p[12], &d->ax, 4);
    memcpy(&p[16], &d->ay, 4);
    memcpy(&p[20], &d->az, 4);
    tx_build_and_push(TYPE_IMU, p, LEN_IMU);
}

static void Send_Battery(float voltage)
{
    uint8_t p[LEN_BATTERY];
    memcpy(&p[0], &voltage, 4);
    tx_build_and_push(TYPE_BATTERY, p, LEN_BATTERY);
}

/* ==========================================================================
 * Control loop
 * ========================================================================== */

void Robot_Set_Velocity(float v_in, float w_in)
{
    cmd_v = v_in;
    cmd_w = w_in;
    last_cmd_ms = HAL_GetTick();
}

static void Control_Update(void)
{
    static uint32_t last_ctrl_ms = 0;

    uint32_t now_ms = HAL_GetTick();
    float dt = CTRL_DT;
    if (last_ctrl_ms != 0) {
        uint32_t dms = now_ms - last_ctrl_ms;
        dt = clampf((float)dms * 0.001f, 0.001f, 0.050f);
    }
    last_ctrl_ms = now_ms;

    /* ---- Command timeout: safely coast to zero ---- */
    /* Atomic snapshot so the two floats come from the same command frame. */
    uint32_t primask = __get_PRIMASK();
    __disable_irq();
    float local_cmd_v = cmd_v;
    float local_cmd_w = cmd_w;
    uint32_t local_last_cmd_ms = last_cmd_ms;
    __set_PRIMASK(primask);

    bool timed_out = (now_ms - local_last_cmd_ms) > CMD_TIMEOUT_MS;
    if (timed_out) {
        local_cmd_v = 0.0f;
        local_cmd_w = 0.0f;
    }

    /* ---- Wheel targets from (v,w) ---- */
    float target_L = local_cmd_v + (local_cmd_w * Lw * 0.5f);
    float target_R = local_cmd_v - (local_cmd_w * Lw * 0.5f);

    /* ---- Slew-limit to respect max accel ---- */
    const float max_dv = MAX_ACCEL_MPS2 * dt;
    desired_speed_L += clampf(target_L - desired_speed_L, -max_dv, +max_dv);
    desired_speed_R += clampf(target_R - desired_speed_R, -max_dv, +max_dv);

    /* ---- Motor feedback (drive encoders) ---- */
    int16_t dMotorL = (int16_t)(encoder_if_delta(&enc_motor_L_if) * MOTOR_SIGN_L);
    int16_t dMotorR = (int16_t)(encoder_if_delta(&enc_motor_R_if) * MOTOR_SIGN_R);

    float motorL_revs = (float)dMotorL / (float)ENCODER_COUNTS_PER_MOTOR_REV;
    float motorR_revs = (float)dMotorR / (float)ENCODER_COUNTS_PER_MOTOR_REV;
    float wheelL_revs = motorL_revs / GEAR_RATIO;
    float wheelR_revs = motorR_revs / GEAR_RATIO;
    float wheel_circ  = (float)M_PI * WHEEL_DIAMETER;

    float vL_meas_raw = (wheelL_revs * wheel_circ) / dt;
    float vR_meas_raw = (wheelR_revs * wheel_circ) / dt;

    /* IIR low-pass to tame single-count quantization noise at low speed */
    vL_filt = (1.0f - VEL_FILT_ALPHA) * vL_filt + VEL_FILT_ALPHA * vL_meas_raw;
    vR_filt = (1.0f - VEL_FILT_ALPHA) * vR_filt + VEL_FILT_ALPHA * vR_meas_raw;
    speed_L = vL_filt;
    speed_R = vR_filt;

    /* ---- Odometry from deadwheels ---- */
    int16_t dDwH = (int16_t)(encoder_if_delta(&enc_dw_H_if) * DW_SIGN_H);
    int16_t dDwS = (int16_t)(encoder_if_delta(&enc_dw_S_if) * DW_SIGN_S);

    float vS_odom = counts_to_linear_mps((int32_t)dDwS, dt,
                                         ENCODER_COUNTS_PER_DW_REV,
                                         DEADWHEEL_DIAMETER_M);
    float vH_odom = counts_to_linear_mps((int32_t)dDwH, dt,
                                         ENCODER_COUNTS_PER_DW_REV,
                                         DEADWHEEL_DIAMETER_M);

    float w_robot = vH_odom / DW_H_OFFSET_X;
    float v_robot = vS_odom + (w_robot * DW_S_OFFSET_Y);

    robot_Theta = wrap_pi(robot_Theta + w_robot * dt);
    robot_X += v_robot * cosf(robot_Theta) * dt;
    robot_Y += v_robot * sinf(robot_Theta) * dt;

    odom_v = v_robot;
    odom_w = w_robot;

    /* ---- PI control with anti-windup + deadband comp ---- */
    float eL = desired_speed_L - vL_filt;
    float eR = desired_speed_R - vR_filt;

    /* Tentative output */
    float uL = KP * eL + i_term_L;
    float uR = KP * eR + i_term_R;

    /* Pre-saturation motor command (desired + correction) */
    float outL = desired_speed_L + uL;
    float outR = desired_speed_R + uR;

    /* Conditional integration: only integrate if output is not saturated
     * in the direction that would wind the integrator further.
     */
    bool satL_hi = (outL >=  MOTOR_CMD_ABS_MAX);
    bool satL_lo = (outL <= -MOTOR_CMD_ABS_MAX);
    bool satR_hi = (outR >=  MOTOR_CMD_ABS_MAX);
    bool satR_lo = (outR <= -MOTOR_CMD_ABS_MAX);

    if (!((satL_hi && eL > 0.0f) || (satL_lo && eL < 0.0f))) {
        i_term_L = clampf(i_term_L + KI * eL * dt,
                          -I_TERM_ABS_MAX, I_TERM_ABS_MAX);
    }
    if (!((satR_hi && eR > 0.0f) || (satR_lo && eR < 0.0f))) {
        i_term_R = clampf(i_term_R + KI * eR * dt,
                          -I_TERM_ABS_MAX, I_TERM_ABS_MAX);
    }

    /* Drain integrator when we're commanded fully stopped */
    if ((fabsf(local_cmd_v) < CMD_DEAD_THRESH) &&
        (fabsf(local_cmd_w) < CMD_DEAD_THRESH)) {
        i_term_L *= 0.98f;
        i_term_R *= 0.98f;
    }

    /* If the host hasn't talked to us in a while, drop the integrators entirely
     * so that the next fresh command doesn't inherit stale windup. */
    if (timed_out) {
        i_term_L = 0.0f;
        i_term_R = 0.0f;
    }

    /* Recompute output with final integrator and apply */
    outL = clampf(desired_speed_L + KP * eL + i_term_L,
                  -MOTOR_CMD_ABS_MAX, MOTOR_CMD_ABS_MAX);
    outR = clampf(desired_speed_R + KP * eR + i_term_R,
                  -MOTOR_CMD_ABS_MAX, MOTOR_CMD_ABS_MAX);

    Motor_SetSpeed_L(outL);
    Motor_SetSpeed_R(outR);
}

/* ==========================================================================
 * Battery ADC
 * ========================================================================== */

static uint32_t Read_ADC_Raw(void)
{
    uint32_t v = 0;
    HAL_ADC_Start(&hadc1);
    if (HAL_ADC_PollForConversion(&hadc1, 10) == HAL_OK) {
        v = HAL_ADC_GetValue(&hadc1);
    }
    HAL_ADC_Stop(&hadc1);
    return v;
}

static float Read_Battery_Voltage_Filtered(void)
{
    uint32_t raw = Read_ADC_Raw();
    float pin_v = ((float)raw * 3.3f) / 4095.0f;
    /* Divider: 100k to battery, 22k to ground  -> ratio (100+22)/22 */
    const float divider_ratio = (100.0f + 22.0f) / 22.0f;
    const float calibration   = 0.9848f;
    float battery_v = pin_v * divider_ratio * calibration;

    if (!battery_initialized) {
        battery_voltage_filt = battery_v;
        battery_initialized = true;
    } else {
        battery_voltage_filt =
            (1.0f - BATTERY_FILT_ALPHA) * battery_voltage_filt +
            BATTERY_FILT_ALPHA * battery_v;
    }
    return battery_voltage_filt;
}

/* ==========================================================================
 * IWDG (independent watchdog)
 * Reset window ~500 ms. Everything in the main loop is well under that.
 * ========================================================================== */

static void IWDG_Init(void)
{
    hiwdg.Instance       = IWDG;
    hiwdg.Init.Prescaler = IWDG_PRESCALER_64;  /* LSI/64 ~= 500 Hz (2 ms) */
    hiwdg.Init.Window    = IWDG_WINDOW_DISABLE;
    hiwdg.Init.Reload    = 250;                /* 250 * 2 ms = 500 ms timeout */
    (void)HAL_IWDG_Init(&hiwdg);
}

