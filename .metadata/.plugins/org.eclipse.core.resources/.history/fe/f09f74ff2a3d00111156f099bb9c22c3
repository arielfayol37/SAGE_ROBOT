static inline float clampf(float x, float lo, float hi)
{
    if (x < lo) return lo;
    if (x > hi) return hi;
    return x;
}

static inline float wrap_pi(float a)
{
    /* Wrap to [-pi, +pi] -- ROS convention */
    const float two_pi = 2.0f * (float)M_PI;
    a = fmodf(a + (float)M_PI, two_pi);
    if (a < 0.0f) a += two_pi;
    return a - (float)M_PI;
}

static uint16_t crc16_ccitt(const uint8_t *data, uint16_t len)
{
    uint16_t crc = 0xFFFF;
    while (len--) {
        crc ^= ((uint16_t)(*data++)) << 8;
        for (int i = 0; i < 8; i++) {
            crc = (crc & 0x8000) ? (uint16_t)((crc << 1) ^ 0x1021)
                                 : (uint16_t)(crc << 1);
        }
    }
    return crc;
}

/* ==========================================================================
 * UART TX: interrupt-based ring buffer
 *   - Multiple producers push frames via UART_TxPush()
 *   - UART_TxKick() starts a transmission if idle
 *   - HAL_UART_TxCpltCallback restarts on completion until ring is drained
 * ========================================================================== */

static void UART_TxPush(const uint8_t *p, uint16_t n)
{
    uint32_t primask = __get_PRIMASK();
    __disable_irq();
    for (uint16_t i = 0; i < n; i++) {
        uint16_t next = (uint16_t)((tx_head + 1U) % TX_RING_SIZE);
        if (next == tx_tail) {
            /* buffer full: drop remainder to keep control loop going */
            break;
        }
        tx_ring[tx_head] = p[i];
        tx_head = next;
    }
    __set_PRIMASK(primask);
    UART_TxKick();
}

static void UART_TxKick(void)
{
    uint32_t primask = __get_PRIMASK();
    __disable_irq();
    if (tx_busy || (tx_head == tx_tail)) {
        __set_PRIMASK(primask);
        return;
    }
    uint16_t n = 0;
    while ((tx_tail != tx_head) && (n < TX_SCRATCH_SIZE)) {
        tx_scratch[n++] = tx_ring[tx_tail];
        tx_tail = (uint16_t)((tx_tail + 1U) % TX_RING_SIZE);
    }
    tx_busy = true;
    __set_PRIMASK(primask);

    if (HAL_UART_Transmit_IT(&huart2, tx_scratch, n) != HAL_OK) {
        /* HAL refused (e.g., still in error state); clear busy so kick retries. */
        tx_busy = false;
    }
}

void HAL_UART_TxCpltCallback(UART_HandleTypeDef *huart)
{
    if (huart->Instance != USART2) return;
    tx_busy = false;
    UART_TxKick();
}

/* ==========================================================================
 * UART RX: byte-at-a-time state machine with SOF resync + CRC verify
 * ========================================================================== */

static void UART_StartRx(void)
{
    rx_state = RX_WAIT_SOF;
    rx_frame_len = 0;
    rx_expected_len = 0;

    __HAL_UART_CLEAR_OREFLAG(&huart2);
    __HAL_UART_CLEAR_NEFLAG(&huart2);
    __HAL_UART_CLEAR_FEFLAG(&huart2);
    __HAL_UART_CLEAR_PEFLAG(&huart2);
    __HAL_UART_CLEAR_IDLEFLAG(&huart2);

    HAL_UART_Receive_IT(&huart2, &rx_byte, 1);
}

static void process_rx_frame(uint8_t type, const uint8_t *payload, uint8_t len)
{
    if (type == TYPE_CMD && len == LEN_CMD) {
        float new_v, new_w;
        memcpy(&new_v, &payload[0], sizeof(float));
        memcpy(&new_w, &payload[4], sizeof(float));
        if (isfinite(new_v) && isfinite(new_w)) {
            cmd_v = new_v;
            cmd_w = new_w;
            last_cmd_ms = HAL_GetTick();
            HAL_GPIO_TogglePin(GPIOA, GPIO_PIN_5);  /* activity LED */
        }
    }
    /* unknown types ignored */
}

void HAL_UART_RxCpltCallback(UART_HandleTypeDef *huart)
{
    if (huart->Instance != USART2) return;
    rx_last_byte_ms = HAL_GetTick();

    uint8_t b = rx_byte;
    switch (rx_state) {
    case RX_WAIT_SOF:
        if (b == SOF) {
            rx_frame[0] = b;
            rx_frame_len = 1;
            rx_state = RX_WAIT_HDR;
        }
        break;

    case RX_WAIT_HDR:
        rx_frame[rx_frame_len++] = b;
        /* rx_frame now: [SOF][VER][TYPE][LEN] when rx_frame_len == 4 */
        if (rx_frame_len >= 4) {
            uint8_t ver = rx_frame[1];
            uint8_t len = rx_frame[3];
            if (ver != PROTO_VER || len > (MAX_FRAME_SIZE - FRAME_OVERHEAD)) {
                /* bogus header, resync */
                rx_state = RX_WAIT_SOF;
                rx_frame_len = 0;
                rx_crc_err_count++;
            } else {
                rx_expected_len = (uint16_t)(FRAME_OVERHEAD + len);
                rx_state = RX_WAIT_BODY;
            }
        }
        break;

    case RX_WAIT_BODY:
        rx_frame[rx_frame_len++] = b;
        if (rx_frame_len >= rx_expected_len) {
            uint8_t type   = rx_frame[2];
            uint8_t len    = rx_frame[3];
            uint16_t body_start = 1;                  /* VER */
            uint16_t body_len   = (uint16_t)(3 + len); /* VER+TYPE+LEN+payload */
            uint16_t crc_off    = (uint16_t)(1 + body_len);
            uint16_t crc_rx = (uint16_t)(rx_frame[crc_off] |
                                         ((uint16_t)rx_frame[crc_off + 1] << 8));
            uint16_t crc_calc = crc16_ccitt(&rx_frame[body_start], body_len);

            if (crc_rx == crc_calc) {
                process_rx_frame(type, &rx_frame[4], len);
            } else {
                rx_crc_err_count++;
            }
            rx_state = RX_WAIT_SOF;
            rx_frame_len = 0;
        }
        break;
    }

    HAL_UART_Receive_IT(&huart2, &rx_byte, 1);
}

void HAL_UART_ErrorCallback(UART_HandleTypeDef *huart)
{
    if (huart->Instance != USART2) return;
    uart_error_count++;
    (void)HAL_UART_AbortReceive_IT(&huart2);
    UART_StartRx();
}

static void UART_RxWatchdog(void)
{
    /* If we started a frame but never completed it, resync after 200 ms. */
    if (rx_state != RX_WAIT_SOF) {
        uint32_t now = HAL_GetTick();
        if ((now - rx_last_byte_ms) > 200U) {
            (void)HAL_UART_AbortReceive_IT(&huart2);
            UART_StartRx();
        }
    }
}

/* ==========================================================================
 * Motor control
 * ========================================================================== */

/* Map wheel speed (m/s) -> servo PWM in microseconds with deadband compensation.
 * The ESC has a dead zone around 1500 us where no motion occurs. When we want
 * to move, skip past that region instead of sending a PWM that does nothing.
 */
static uint16_t speed_to_pwm_us(float wheel_mps, bool moving_intent)
{
    float raw_us = 1500.0f + wheel_mps * 100.0f;

    if (moving_intent) {
        if (wheel_mps > 0.0f && raw_us < (1500.0f + MOTOR_DEADBAND_US)) {
            raw_us = 1500.0f + MOTOR_DEADBAND_US;
        } else if (wheel_mps < 0.0f && raw_us > (1500.0f - MOTOR_DEADBAND_US)) {
            raw_us = 1500.0f - MOTOR_DEADBAND_US;
        }
    }

    if (raw_us > (float)PWM_MAX_US) raw_us = (float)PWM_MAX_US;
    if (raw_us < (float)PWM_MIN_US) raw_us = (float)PWM_MIN_US;
    return (uint16_t)raw_us;
}

static void Motor_SetSpeed_L(float v)
{
    bool moving = fabsf(desired_speed_L) > CMD_DEAD_THRESH;
    uint16_t us = speed_to_pwm_us(v, moving);
    __HAL_TIM_SET_COMPARE(PWM_TIM_L, PWM_CH_L, us);
}

static void Motor_SetSpeed_R(float v)
{
    /* Right motor is inverted relative to left */
    bool moving = fabsf(desired_speed_R) > CMD_DEAD_THRESH;
    uint16_t us = speed_to_pwm_us(-v, moving);
    __HAL_TIM_SET_COMPARE(PWM_TIM_R, PWM_CH_R, us);
}

