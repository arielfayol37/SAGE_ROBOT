    HAL_ADC_Start(&hadc1);

    last_cmd_ms = HAL_GetTick();

    UART_StartRx();

    /* Enable watchdog last so peripheral init can't trip it */
    IWDG_Init();

    const uint32_t tick_period    = 1000U / CTRL_HZ_INT;   /* 10 ms */
    const uint32_t odom_period    = 1000U / 50U;           /* 20 ms */
    const uint32_t imu_period     = 1000U / 100U;          /* 10 ms */
    const uint32_t battery_period = 1000U / 10U;           /* 100 ms */
    const uint32_t iwdg_period    = 100U;                  /* refresh at 10 Hz */

    uint32_t prev_ctrl_ms    = 0;
    uint32_t prev_odom_ms    = 0;
    uint32_t prev_imu_ms     = 0;
    uint32_t prev_battery_ms = 0;
    uint32_t prev_iwdg_ms    = 0;

  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
    while (1)
    {
    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */

        uint32_t now = HAL_GetTick();

        /* RX resync watchdog (in case a frame mid-stream gets stranded) */
        UART_RxWatchdog();

        /* TX kick -- in case a previous push happened with TX full */
        UART_TxKick();

        if ((now - prev_ctrl_ms) >= tick_period) {
            prev_ctrl_ms = now;
            Control_Update();
        }

        if ((now - prev_odom_ms) >= odom_period) {
            prev_odom_ms = now;
            Send_Odom();
        }

        if ((now - prev_imu_ms) >= imu_period) {
            prev_imu_ms = now;
            IMU_Data_t d = Read_IMU();
            Send_Imu(&d);
        }

        if ((now - prev_battery_ms) >= battery_period) {
            prev_battery_ms = now;
            float v_bat = Read_Battery_Voltage_Filtered();
            Send_Battery(v_bat);
        }

        if ((now - prev_iwdg_ms) >= iwdg_period) {
            prev_iwdg_ms = now;
            HAL_IWDG_Refresh(&hiwdg);
        }
    }
  /* USER CODE END 3 */
}

