# Create a .env file in the root of the project with the following content, replacing the placeholder values with your actual configuration:

POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password_here
DB_HOST=db
DB_PORT=5432

DJANGO_SECRET_KEY=secret_django_key_here
DJANGO_DEBUG=True
DJANGO_SU_USERNAME=agi
DJANGO_SU_PASSWORD=password_here
DJANGO_SU_EMAIL=email_here

OPENAI_API_KEY=openai_api_key_here
# KB_EMBEDDER_BACKEND=local
# KB_EMBED_DIM would change depending on the local model
KB_EMBEDDER_BACKEND=openai
KB_OPENAI_EMBED_MODEL=text-embedding-3-small
KB_EMBED_DIM=1536

EMAIL_HOST=email_host_here # e.g., 'smtp.gmail.com'
EMAIL_PORT=email_port_here # e.g., 587 for TLS
EMAIL_USE_TLS=True
EMAIL_HOST_USER=email_host_user_here # Your Gmail address
EMAIL_HOST_PASSWORD=email_host_password_here # Your Gmail password
